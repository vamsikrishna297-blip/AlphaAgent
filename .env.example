# Template for local .env settings
# Copy this file to `.env` and fill values before running AlphaAgent.
# Note: keep this file dotenv-compatible (no Python triple-quoted strings).

# Global configs:
USE_AZURE=False
CHAT_USE_AZURE_TOKEN_PROVIDER=False
EMBEDDING_USE_AZURE_TOKEN_PROVIDER=False
MAX_RETRY=5
RETRY_WAIT_SECONDS=5
FACTOR_MINING_TIMEOUT=10800 # 最大运行时间
USE_LOCAL=True

# LLM API Setting:
OPENAI_BASE_URL=<your_base_url>
OPENAI_API_KEY=<your_api_key>
CHAT_MODEL=<your_chat_model> # e.g., "deepseek-v3"
REASONING_MODEL=<your_reasoning_model> # e.g. "deepseek-reasoner"
EMBEDDING_MODEL=text-embedding-3-small # RAG

CHAT_MAX_TOKENS=4000
CHAT_TEMPERATURE=0.7

# Qlib market defaults (used for data bootstrap + config selection)
QLIB_DEFAULT_DATA_DIR=~/.qlib/qlib_data/cn_data
QLIB_DEFAULT_REGION=cn
QLIB_FACTOR_BASE_CONFIG=conf.yaml
QLIB_FACTOR_COMBINED_CONFIG=conf_cn_combined_kdd_ver.yaml
QLIB_PROVIDER_URI=~/.qlib/qlib_data/cn_data
